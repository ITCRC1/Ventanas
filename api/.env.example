# Copiar a api/.env y ajustar. NUNCA commitear api/.env (ya está en .gitignore).
# En Railway nada de esto va a un archivo: son variables del servicio.
# Guía de despliegue: docs/05_DESPLIEGUE_RAILWAY.md

# --- Base de datos (SQLAlchemy + psycopg3). El Postgres local escucha en 5433 ---
# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# El sufijo +psycopg lo agrega solo la app si viene sin él.
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@localhost:5433/dashboard_ventanas

# --- App ---
ENV=dev                      # prod en Railway
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000"]
# URL pública del front. En Railway: https://<dominio-del-servicio-web>
# Sólo se usa para volver a la app después del callback de OIDC.
WEB_BASE_URL=

# --- Sesión / JWT ---
JWT_SECRET=cambia-esto-por-un-secreto-largo
COOKIE_SECURE=false          # con ENV=prod se fuerza a true, esta línea sobra

# --- OIDC Microsoft 365 (lo activa el dueño del tenant; ver DECISIONES §9.4) ---
OIDC_ENABLED=false
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# En Railway el callback entra por el dominio del FRONT, que reenvía /api/* a
# la API: https://<dominio-del-servicio-web>/api/auth/callback
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Login de desarrollo sin Azure (solo con ENV=dev; en prod devuelve 404)
DEV_LOGIN_ENABLED=true

# Portón de contraseña compartida mientras OIDC no esté activo. Vacío = apagado.
SHARED_PASSWORD=
SHARED_LOGIN_USER=bismark

# --- Bandeja de facturas por correo (IMAP). Vacío = el sync queda dormido ---
INVOICE_IMAP_HOST=imap.gmail.com
INVOICE_IMAP_PORT=993
INVOICE_IMAP_USER=
INVOICE_IMAP_PASSWORD=       # App Password de Gmail, NO la clave del correo
INVOICE_IMAP_FOLDER=INBOX
INVOICE_SYNC_INTERVAL_MIN=15

# --- Endurecimiento ---
DISB_APPROVAL_THRESHOLD=25000
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_S=60

# --- Sólo Railway (las inyecta la plataforma o el Dockerfile) ---
# PORT=8080                  # fijala a 8080 para que la URL privada sea estable
# WEB_CONCURRENCY=2          # workers de gunicorn
